{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/downloads/(.*)", "dest": "/downloads/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/app/(.*)", "dest": "/index.html" },
    { "src": "/app", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
